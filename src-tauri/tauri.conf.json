{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Márcio App",
  "version": "1.0.0",
  "identifier": "com.marcio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/control/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Márcio App",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "setup",
        "title": "Márcio App — Setup",
        "url": "setup-wizard.html",
        "width": 560,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "dist/**/*",
      "data/**/*",
      "package.json",
      "patch-whatsapp-web.js",
      "changelog.json"
    ],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Márcio App — bot do WhatsApp com IA",
    "longDescription": "Márcio App é um bot do WhatsApp com IA conversacional, memória permanente, figurinhas, comandos assistivos e painel de controle web."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ydm-r/marcio-app/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "PLACEHOLDER_GENERAR_CON_TAURI_SIGNER"
    }
  }
}
