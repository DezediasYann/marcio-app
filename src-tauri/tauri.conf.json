{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marcio.App",
  "version": "1.0.4",
  "identifier": "com.marcio.app",
  "build": {
    "beforeDevCommand": "node precopy.js && npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "node precopy.js && npm run build && node prepare-bundle.js",
    "frontendDist": "../src/control/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Márcio App",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "setup",
        "title": "Márcio App — Setup",
        "url": "setup-wizard.html",
        "width": 560,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "preparing",
        "title": "",
        "url": "preparing.html",
        "width": 400,
        "height": 320,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "dist/**/*",
      "data/**/*",
      "package.json",
      "patch-whatsapp-web.js",
      "changelog.json",
      "node-portable*",
      "node_modules.zip",
      "dist-bundle.zip"
    ],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Márcio App — bot do WhatsApp com IA",
    "longDescription": "Márcio App é um bot do WhatsApp com IA conversacional, memória permanente, figurinhas, comandos assistivos e painel de controle web."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DezediasYann/marcio-app/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3OERERjk5NzAzQkM2NzkKUldSNXhqdHdtZCtOUnlhMzRqTFBqa01wc2RGVGcrMU5MWUpJQlF3WTRmTHAwbEUxRW9FYzFNR3UK"
    }
  }
}