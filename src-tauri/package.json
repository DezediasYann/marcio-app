{
  "name": "marcio-app",
  "version": "1.0.3-8",
  "private": true,
  "description": "Márcio App — bot de WhatsApp com IA",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "start": "tsx src/bot.ts",
    "build": "tsc && node copy-assets.js && node copy-to-tauri.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "node patch-whatsapp-web.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "signer:generate": "tauri signer generate -w ~/.tauri/marcio-app.key",
    "signer:generate:ci": "tauri signer generate -w $RUNNER_TEMP/marcio-app.key"
  },
  "dependencies": {
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@types/ws": "^8.18.2",
    "jimp": "^0.22.12",
    "mathjs": "^15.2.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "puppeteer@*": true,
    "marcio-app": true
  }
}