{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Márcio App",
  "version": "1.0.0",
  "identifier": "com.marcio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/control/public"
  },
  "app": {
    "windows": [
      {
        "title": "Márcio App",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Márcio App — bot do WhatsApp com IA",
    "longDescription": "Márcio App é um bot do WhatsApp com IA conversacional, memória permanente, figurinhas, comandos assistivos e painel de controle web."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ydm-r/marcio-app/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMTg4MDA3RDc3OTA3QTYKUldTbUIzblhCNEFZKzVGNlkzTnNWbm56NmgzMlhxMGxyN3ZiRXJKeVlkZy84TXhPR2h0cmFvNWUK"
    }
  }
}
